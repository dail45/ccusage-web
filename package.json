{
  "name": "ccusage-webui",
  "version": "0.2.1",
  "description": "Local web dashboard for monitoring Claude Code and AI agent token usage and costs",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "token-usage",
    "cost-tracker",
    "usage-dashboard",
    "ai-cost-monitoring",
    "claude-billing",
    "ccusage",
    "developer-tools",
    "nextjs",
    "dashboard"
  ],
  "homepage": "https://github.com/dail45/ccusage-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dail45/ccusage-web.git"
  },
  "bugs": {
    "url": "https://github.com/dail45/ccusage-web/issues"
  },
  "license": "MIT",
  "author": "dail45",
  "main": "electron/main.cjs",
  "bin": {
    "ccusage-webui": "bin/ccusage-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/dev",
    "!.next/cache",
    "!.next/standalone",
    "!.next/trace*",
    "public",
    "app",
    "components",
    "lib",
    "next.config.ts",
    "tsconfig.json",
    "components.json",
    "postcss.config.mjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "electron:dev": "electron .",
    "electron:build-next": "cross-env NEXT_OUTPUT=standalone next build && node scripts/prepare-electron.mjs",
    "electron:start": "npm run electron:build-next && cross-env ELECTRON_SERVER=standalone electron .",
    "electron:dist": "npm run electron:build-next && electron-builder",
    "electron:dist:dir": "npm run electron:build-next && electron-builder --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "ccusage": "20.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "10.1.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
